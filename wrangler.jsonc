{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "philex",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
