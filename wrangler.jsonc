{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "philex",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  // Non-secret config lives here so it is visible and version-controlled.
  // MAILAPI_KEY and TURSO_AUTH_TOKEN are deliberately NOT here: they are
  // Cloudflare Secrets, set only with `wrangler secret put` (or in the
  // dashboard, Settings -> Variables and Secrets). Never put a secret in this
  // file - it is committed to git. The dashboard's "keep deployments in sync"
  // banner suggests moving them here; ignore that for the secrets.
  "vars": {
    "MAILAPI_URL": "https://mailapi-lemon.vercel.app",
    "EMAIL_TO": "info@philexentertainment.com",
    "TURSO_DATABASE_URL": "libsql://philex-doombuggy.aws-us-east-1.turso.io"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
